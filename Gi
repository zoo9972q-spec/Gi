btnCorner.Parent = immortalButton

local isImmortal = false
local heartbeatConn = nil

local function syncHealth(humanoid)
	if not humanoid or humanoid.Health <= 0 then return end
	if humanoid.MaxHealth < 100 then
		humanoid.MaxHealth = 100
	end
	if humanoid.Health < humanoid.MaxHealth then
		humanoid.Health = humanoid.MaxHealth
	end
end

local function setImmortalState(state)
	isImmortal = state

	if isImmortal then
		immortalButton.Text = "อมตะ : เปิด"
		immortalButton.BackgroundColor3 = Color3.fromRGB(255, 45, 55)

		if heartbeatConn then
			heartbeatConn:Disconnect()
		end

		heartbeatConn = RunService.Heartbeat:Connect(function()
			if not isImmortal then return end
			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				syncHealth(humanoid)
			end
		end)
	else
		immortalButton.Text = "อมตะ : ปิด"
		immortalButton.BackgroundColor3 = Color3.fromRGB(215, 25, 35)

		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	end
end

immortalButton.MouseButton1Click:Connect(function()
	setImmortalState(not isImmortal)
end)

-- คอยรองรับตอนตัวละครเกิดใหม่
player.CharacterAdded:Connect(function(char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	if isImmortal and humanoid then
		syncHealth(humanoid)
	end
end)
